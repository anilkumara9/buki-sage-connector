# Sage developer app (sandbox first)
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_SUBSCRIPTION_KEY=
SAGE_REDIRECT_URI=http://localhost:3000/auth/sage/callback
SAGE_AUTH_URL=https://www.sageone.com/oauth2/auth/central?filter=apiv3.1
SAGE_TOKEN_URL=https://oauth.accounting.sage.com/token
SAGE_API_BASE=https://api.accounting.sage.com/v3.1
SAGE_SCOPE=full_access

# Connector
PORT=3000
# 12-month historical window, active contacts only (see PROOF.md assumptions)
SYNC_MONTHS_BACK=12
TOKEN_STORE_PATH=.data/tokens.json
